# ==========================================
# OOP EXAM GRADING SYSTEM - TEMPLATE ENVIRONMENT
# Instructions: Copy this file to .env and fill in your actual values.
# DO NOT put real passwords or secrets in this file!
# ==========================================

# 1. Server Configuration
PORT=8080

# 2. Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/oop_exam_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# 3. Security Configuration
# JWT Secret (Must be highly secure and random, min 64 characters)
JWT_SECRET=your_jwt_secret_key_here

# 4. CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173
