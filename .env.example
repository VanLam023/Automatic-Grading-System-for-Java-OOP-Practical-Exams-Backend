# ==========================================
# OOP EXAM GRADING SYSTEM - TEMPLATE ENVIRONMENT
# Instructions: Copy this file to .env and fill in your actual values.
# DO NOT put real passwords or secrets in this file!
# ==========================================

# 1. Server Configuration
PORT=8080

# 2. Database Configuration
# You can use a local Docker database:
# DB_URL=jdbc:postgresql://localhost:5432/oop_exam_db
# DB_USERNAME=postgres
# DB_PASSWORD=your_db_password_here

# OR use a remote Supabase/cloud database:
DB_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
DB_USERNAME=your_remote_db_user_here
DB_PASSWORD=your_remote_db_password_here

# 3. Security Configuration
# JWT Secret (Must be highly secure and random, min 64 characters)
JWT_SECRET=your_jwt_secret_key_here

# 4. CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173
